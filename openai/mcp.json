{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "rica-pro": {
      "type": "streamable-http",
      "url": "https://pro.mcp.rica.com.br/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "baseScopes": ["clientes:read", "clientes:write"]
          }
        }
      }
    }
  }
}
